
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>نظام إدارة الطلاب</title>
<style>
body{font-family:Arial;background:#f0f2f5;padding:20px}
.container{max-width:600px;background:#fff;padding:20px;margin:auto;border-radius:12px;box-shadow:0 2px 10px #ccc}
h1{text-align:center;color:#1a73e8}
input{width:100%;padding:10px;margin:8px 0;border:1px solid #ccc;border-radius:8px;box-sizing:border-box}
button{width:100%;padding:12px;background:#1a73e8;color:#fff;border:0;border-radius:8px;font-size:16px}
.card{background:#f8f9fa;padding:12px;margin:10px 0;border-radius:8px;display:flex;justify-content:space-between;align-items:center}
.del{background:#e53935;width:auto;padding:6px 12px}
</style>
</head>
<body>
<div class="container">
<h1>نظام إدارة الطلاب</h1>
<input id="name" placeholder="اسم الطالب">
<input id="id" placeholder="رقم الطالب">
<input id="grade" placeholder="الدرجة / التخصص">
<button onclick="addStudent()">إضافة طالب</button>
<input id="search" placeholder="ابحث بالاسم..." onkeyup="show()">
<div id="list"></div>
</div>
<script>
let students = JSON.parse(localStorage.getItem('students')||'[]');
function addStudent(){
 let n=document.getElementById('name').value;
 let i=document.getElementById('id').value;
 let g=document.getElementById('grade').value;
 if(!n||!i){alert('اكتب الاسم ورقم الطالب');return;}
 students.push({name:n,id:i,grade:g});
 localStorage.setItem('students',JSON.stringify(students));
 document.getElementById('name').value='';
 document.getElementById('id').value='';
 document.getElementById('grade').value='';
 show();
}
function delStudent(index){
 students.splice(index,1);
 localStorage.setItem('students',JSON.stringify(students));
 show();
}
function show(){
 let q=document.getElementById('search').value.toLowerCase();
 let html='';
 students.forEach((s,i)=>{
  if(s.name.toLowerCase().includes(q)){
   html+=`<div class="card"><div><b>${s.name}</b><br>رقم: ${s.id} - ${s.grade}</div><button class="del" onclick="delStudent(${i})">حذف</button></div>`;
  }
 });
 document.getElementById('list').innerHTML = html || '<p style="text-align:center">لا يوجد طلاب بعد</p>';
}
show();
</script>
</body>
</html>
